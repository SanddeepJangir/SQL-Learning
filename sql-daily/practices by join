-- q.1 employees who were never promoted

SELECT e.emp_id
FROM employees e
LEFT JOIN promotions p ON e.emp_id = p.emp_id
WHERE p.emp_id IS NULL;


-- Q.2. Salary Changes but No Promotion

SELECT DISTINCT s.emp_id
FROM salaries s
LEFT JOIN promotions p ON s.emp_id = p.emp_id
WHERE p.emp_id IS NULL;


-- Q 3. Salary Doubled Within 2 Years

SELECT DISTINCT s1.emp_id
FROM salaries s1
JOIN salaries s2 
  ON s1.emp_id = s2.emp_id
 AND s2.change_date <= DATE_ADD(s1.change_date, INTERVAL 2 YEAR)
AND s2.salary >= 2 * s1.salary;

 -- Q 4. First Salary After Promotion
 
 SELECT p.emp_id, MIN(s.change_date) AS first_salary_after_promo
FROM promotions p
JOIN salaries s
  ON p.emp_id = s.emp_id
 AND s.change_date > p.promo_date
GROUP BY p.emp_id;

-- Q. 5. Average Tenure per Department

SELECT dept,
AVG(DATEDIFF(CURDATE(), join_date)/365) AS avg_years
FROM employees
GROUP BY dept;

-- 6. Employees with Overlapping Projects
SELECT DISTINCT p1.emp_id
FROM projects p1
JOIN projects p2
  ON p1.emp_id = p2.emp_id
 AND p1.project_id <> p2.project_id
 AND p1.start_date <= p2.end_date
 AND p2.start_date <= p1.end_date;

-- Q 7. Salary Growth Slowed Down YoY

WITH salary_growth AS (
  SELECT emp_id,
         change_date,
         salary - LAG(salary) OVER (PARTITION BY emp_id ORDER BY change_date) AS growth
  FROM salaries
)
SELECT emp_id
FROM (
  SELECT emp_id,
         growth,
         LAG(growth) OVER (PARTITION BY emp_id ORDER BY change_date) AS prev_growth
  FROM salary_growth
) t
WHERE growth < prev_growth;

-- Q.8 Percentile Rank Company-Wide 
SELECT emp_id,
       salary,
       PERCENT_RANK() OVER (ORDER BY salary) AS percentile_rank
FROM salaries;

-- Q.9. Department with Highest Promotion Rate

SELECT e.dept,
COUNT(DISTINCT p.emp_id) / COUNT(DISTINCT e.emp_id) AS promo_rate
FROM employees e
LEFT JOIN promotions p ON e.emp_id = p.emp_id
GROUP BY e.dept
ORDER BY promo_rate DESC;

-- Execution Order of SQL (REAL EXAMPLE)

-- Query:

SELECT dept, COUNT(*) 
FROM employees
WHERE join_date >= '2020-01-01'
GROUP BY dept
HAVING COUNT(*) > 1
ORDER BY dept
LIMIT 2;

-- Internal Execution Order:

-- FROM → load employees

-- WHERE → filter join_date ≥ 2020

-- GROUP BY → group by dept

-- HAVING → remove groups with count ≤ 1

-- SELECT → pick dept, COUNT

-- ORDER BY → sort

-- LIMIT → restrict rows



