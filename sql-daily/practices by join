create database company;

use company;

CREATE TABLE employees (
    emp_id INT PRIMARY KEY,
    dept VARCHAR(20),
    join_date DATE
);

CREATE TABLE salaries (
    emp_id INT,
    change_date DATE,
    salary INT
);

CREATE TABLE promotions (
    emp_id INT,
    promo_date DATE
);

CREATE TABLE projects (
    emp_id INT,
    project_id INT,
    start_date DATE,
    end_date DATE
);


