DECLARE 
    var1 INT := 4;
    v_factor INT := 1;  
BEGIN
    FOR i IN 2..(var1/2) LOOP
        IF MOD(var1, i) = 0 THEN
            v_factor := 0;  
            EXIT;
        END IF;
    END LOOP;
    
    IF v_factor = 1 THEN 
        DBMS_OUTPUT.PUT_LINE('this is prime');
    ELSE
        DBMS_OUTPUT.PUT_LINE('this is not prime');
    END IF;      
END;
